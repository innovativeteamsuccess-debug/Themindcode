// The Mind Code — database schema.
// SQLite via Prisma. Student Zone: Google-auth users, PDF-built tests
// and real scored attempts. Nothing mock — every row is written by a
// real flow.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  googleId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts TestAttempt[]
}

model TuitionEnquiry {
  id        String   @id @default(cuid())
  studentClass Int
  subject      String
  location     String
  mode         String
  schedule     String
  goal         String
  createdAt    DateTime @default(now())
}

/* A test built by the founder (from an uploaded PDF via the Test
   Builder) or authored manually. questionsJson holds an array of:
   { q, options[4], answerIndex, explanation? } */
model Test {
  id          String   @id @default(cuid())
  title       String
  subject     String
  cls         Int
  minutes     Int      @default(20)
  source      String   @default("pdf") // "pdf" | "manual"
  sourceName  String?  // original uploaded filename
  questions   String   // JSON array of questions
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())

  attempts TestAttempt[]
}

/* One student's graded attempt. score/total are computed server-side
   at submit time; answersJson holds the student's chosen indices. */
model TestAttempt {
  id          String   @id @default(cuid())
  userId      String
  testId      String
  answers     String   // JSON array of chosen option indices
  score       Int
  total       Int
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  test Test @relation(fields: [testId], references: [id])
}
